# Con Docker (etapas 1 y 2): PostgreSQL y MinIO de docker-compose.
DATABASE_URL=postgresql+psycopg://extractor:extractor@postgres:5432/extractor
# Sin Docker (ADR 0003): SQLite y archivos en disco. Descomente y ajuste las rutas.
# DATABASE_URL=sqlite:///C:/ruta/extractor-matriz/datos/extractor.db
# ALMACEN_DIR=C:/ruta/extractor-matriz/datos/almacen
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_PUBLICO=http://localhost:9000
S3_BUCKET=biblioteca
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINERU_URL=http://mineru:8001
# Modelo de lenguaje: Claude Code CLI con la sesión del equipo (ADR 0002), no clave de API.
CLAUDE_CLI=claude
MODELO_EXTRACTOR=claude-opus-5-5
MODELO_AUDITOR=claude-opus-5-5
MODELO_CIEGO=claude-sonnet-5-5
MODELO_CONCILIADOR=claude-opus-5-5
CONCURRENCIA_EXTRACCION=2
UMBRAL_SIMILITUD=95
MAX_ITERACIONES_VALIDADOR=3
UMBRAL_ACUERDO=0.80
TOPE_TOKENS_MENSUAL=
# Sesión y usuario semilla
SESION_SECRETO=
SESION_SEGURA=false
ADMIN_CORREO=admin@local.test
ADMIN_CLAVE=
PROYECTO_NOMBRE=Felicidad y desempeño
CORS_ORIGENES=http://localhost:5173
