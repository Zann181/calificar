# Variables de la nube (Render) — ADR 0009. Cópialas en el panel de Render, NUNCA en el repositorio con valores reales.
MODO=nube
# La cadena de conexión «pooled» de Neon. Sirve tal cual (postgresql://…?sslmode=require): la aplicación la
# convierte a postgresql+psycopg:// y desactiva las sentencias preparadas que el pool de Neon no admite.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Render define PORT solo. En modo nube los archivos van a la base (tabla biblioteca_archivos): no hay ALMACEN_DIR ni S3.

# --- Acceso (falla cerrada: sin estas seis la nube NO arranca) ---
# URL pública del servicio: Google devuelve al lector a /api/v1/auth/google/retorno de esta URL.
URL_PUBLICA=https://TU-SERVICIO.onrender.com
# Correos (con cuenta de Google) que pueden entrar al visor, separados por coma. Lista cerrada.
LECTORES_PERMITIDOS=asesor@ejemplo.com,jurado@ejemplo.com
# Cliente OAuth «Aplicación web» de Google Cloud; alcances openid y email. URI de redirección autorizada:
#   https://TU-SERVICIO.onrender.com/api/v1/auth/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cadena larga y aleatoria (≥ 32 caracteres) que firma la cookie de sesión.
SECRETO_SESION=
# SHA-256 del token del agente local: `python -m app.cli token-sync` imprime el token y este hash.
SYNC_TOKEN_HASH=
