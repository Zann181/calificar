# Variables de la nube (Render) — ADR 0009. Cópialas en el panel de Render, NUNCA en el repositorio con valores reales.
MODO=nube
# La cadena de conexión «pooled» de Neon. Sirve tal cual (postgresql://…?sslmode=require): la aplicación la
# convierte a postgresql+psycopg:// y desactiva las sentencias preparadas que el pool de Neon no admite.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Render define PORT solo. En modo nube los archivos van a la base (tabla biblioteca_archivos): no hay ALMACEN_DIR ni S3.

# Fase 1 (aún no existen): LECTORES_PERMITIDOS, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET, SYNC_TOKEN_HASH.
